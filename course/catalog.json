{
  "title": "Codex 是如何工作的",
  "description": "从“你好”这个 Hello World 入手，查看真实 Codex Desktop 的请求、响应和请求中可见的完整上下文。",
  "groups": [
    {
      "id": "basic",
      "title": "看懂一次运行",
      "description": "找到模型的输入，把工具调用、返回和修复结果串起来。"
    },
    {
      "id": "context",
      "title": "信息从哪里来",
      "description": "分清对话历史、项目规则、技能和记忆怎样进入请求。"
    },
    {
      "id": "extensions",
      "title": "扩展能力与控制执行",
      "description": "调用 MCP 服务，再观察 Hooks、权限、计划和多 Agent 怎样影响执行。"
    },
    {
      "id": "reliability",
      "title": "完成复杂任务与复盘",
      "description": "核对完成与恢复条件，再理解流式输出和各部分的职责。"
    }
  ],
  "lessons": [
    {
      "id": "01-request",
