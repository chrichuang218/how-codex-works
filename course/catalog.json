      "file": "course/01-request.md",
      "status": "verified",
      "evidenceIds": [
        "01-hello"
      ],
      "readingGuide": {
        "focus": "比较两条 user 消息：input[5] 是应用附加的规则与环境，input[6] 是输入框里的“你好”。",
        "targets": [
          {
            "label": "查看规则与环境",
            "experiment": "01-hello",
            "stage": 1,
            "view": "request",
            "input": 5,
            "content": 1
          },
          {
            "label": "查看用户问候",
            "experiment": "01-hello",
            "stage": 1,
            "view": "request",
            "input": 6,
            "content": 0
